def prompt_yes_no(question: str, default_yes: bool = True) -> bool:
    suffix = "(Y/n)" if default_yes else "(y/N)"
    answer = input(f"{question} {suffix}: ").strip().lower()
    if not answer:
        return default_yes
    return answer.startswith("y")


def show_startup_warning() -> bool:
    print("=" * 60)
    print("  WARNING -- manage-system writes directly to real hardware")
    print("=" * 60)
    print()
    print("  This tool reconfigures the OneControl/Unity module itself,")
    print("  not just this bridge's own D-Bus config. There is no")
    print("  config-gated safety net here -- improper use (wrong target,")
    print("  wrong setting) can affect a live system you rely on, including")
    print("  the water pump, water heater, or lights, and there is no")
    print("  touchscreen on this installation to revert a bad write through")
    print("  official tooling.")
    print()
    answer = input(f'  Type "{CONFIRM_PHRASE}" to continue: ').strip().lower()
    print()
    return answer == CONFIRM_PHRASE


def read_pid_value(bus: SocketCanBus, source: int, target: int, pid: int, timeout_sec: float) -> int | None:
    """Returns the PID's current raw value, or None if unsupported
    (RESPONSE.UNKNOWN_ID or any other error shape) or no response at all."""
    send_request(bus, source, target, PID_READ_REQUEST_CODE, build_pid_read_request(pid))
    reply = wait_for_response(bus, source, target, PID_READ_REQUEST_CODE, timeout_sec)
    if reply is None:
        return None
    try:
        parsed = parse_pid_reply(reply)
    except ValueError:
        return None
    if parsed.pid != pid:
        return None  # echoed a different PID -- the confirmed error-reply shape, not a real value
    return parsed.raw_value


def write_pid_verified(bus: SocketCanBus, source: int, target: int, pid: int, value: int, timeout_sec: float) -> bool:
    """Reads the PID's pre-write value, opens a DIAGNOSTIC session, writes
    it, closes the session, then reads back to verify -- the same pattern
    pid_write.py already proved. Reading before writing lets FAIL
    distinguish "write had no effect" (still reads its pre-write value)
    from "changed to something unanticipated" (reads neither the
    pre-write nor the requested value) -- caught for real 2026-08-23: a
    write that looked like RESPONSE.SUCCESS but silently had no effect was
    indistinguishable from a real success until this was added.

    No value_byte_count parameter: build_pid_write_request()'s default (6
    bytes / UInt48) is confirmed the universal real wire width for every
    PID write, not a per-PID choice -- see its docstring and
    ARCHITECTURE.md. Using PID 4/5's own declared Formatter widths (2/1
    bytes) instead of 6 is what caused two real write failures on real
    hardware, 2026-08-23 (PID 4 silently had no effect, PID 5 got
    RESPONSE.BAD_REQUEST).

    Returns True only if the read-back matches the requested value."""
    pre_value = read_pid_value(bus, source, target, pid, timeout_sec)
    session = open_session(bus, source, target, SESSION_ID_DIAGNOSTIC, timeout_sec)
    write_rejected = False
    try:
        write_payload = build_pid_write_request(pid, value)
        send_request(bus, source, target, PID_READ_REQUEST_CODE, write_payload)
        write_reply = wait_for_response(bus, source, target, PID_READ_REQUEST_CODE, timeout_sec)
        if write_reply is None:
            print(f"    WRITE PID {pid}: no response to write request")
        elif write_reply:
            name = RESPONSE_CODE_NAMES.get(write_reply[-1])
            if name and name != "SUCCESS":
                print(f"    WRITE PID {pid}: raw={write_reply.hex()} (RESPONSE.{name})")
                write_rejected = True
    finally:
        close_session(bus, source, target, session)

    readback = read_pid_value(bus, source, target, pid, timeout_sec)
    # A read-back match is not proof of success on its own -- if the device
    # explicitly rejected the write (e.g. RESPONSE.BAD_REQUEST) and the
    # target value happened to equal the value already there, the read-back
    # matches by coincidence, not because the write took effect. Caught for
    # real on 2026-08-22: a FUNCTION_INSTANCE=0 write got BAD_REQUEST but
    # still read back 0 (its pre-existing value) and was wrongly reported
    # PASS.
    if not write_rejected and readback == value:
        print(f"    PASS: PID {pid} now reads {readback}")
        return True
    if readback == pre_value:
        print(f"    FAIL: PID {pid} unchanged -- still reads {readback!r} (its pre-write value), wanted {value}")
    else:
        print(
            f"    FAIL: PID {pid} reads {readback!r} -- neither the requested value ({value}) nor its "
            f"pre-write value ({pre_value!r}) -- changed to something unanticipated, investigate before trusting it"
        )
    return False


def applicable_settings(device_type: DeviceType | None) -> list[ConfigurableSetting]:
    if device_type is None:
        return []
    return [s for s in KNOWN_SETTINGS if device_type in s.applies_to]


def browse_and_pick(matches: list[tuple[int, str]], page_size: int = 50, columns: int = 2) -> int | None:
    """Paginated, multi-column browser over (value, name) pairs -- e.g. all
    446 FUNCTION_NAMEs when the user wants to browse rather than search.
    Numbering is absolute across all pages (not reset per page), so a
    remembered number always picks the same item regardless of how many
    times the user pages back and forth. Column-major layout (fills down
    the first column before starting the second) keeps each column
    alphabetically contiguous, matching search_function_names()'s sort."""
    page = 0
    total_pages = max(1, (len(matches) + page_size - 1) // page_size)
    while True:
        start = page * page_size
        page_items = matches[start : start + page_size]
        rows = (len(page_items) + columns - 1) // columns
        print(f"\n  Page {page + 1}/{total_pages} ({len(matches)} total):")
        for row in range(rows):
            cells = []
            for col in range(columns):
                idx = row + col * rows
                if idx < len(page_items):
                    value, name = page_items[idx]
                    abs_num = start + idx + 1
                    cells.append(f"{abs_num:4d}) {name} ({value})".ljust(38))
            print("  " + "".join(cells))

        nav = []
        if page > 0:
            nav.append("P) Previous page")
        if page < total_pages - 1:
            nav.append("N) Next page")
        nav.append("Q) Cancel")
        print("\n  " + "   ".join(nav))
        choice = input("Pick a number, or a page-navigation letter: ").strip().lower()
        if choice == "n" and page < total_pages - 1:
            page += 1
            continue
        if choice == "p" and page > 0:
            page -= 1
            continue
        if choice == "q" or not choice:
            return None
        try:
            abs_num = int(choice)
            if not (1 <= abs_num <= len(matches)):
                raise ValueError
        except ValueError:
            print("Invalid selection.")
            continue
        return matches[abs_num - 1][0]


