def pick_reference_key(config: ConfigManager) -> StableKey | None:
    devices = config.get_devices()
    return StableKey.from_config_string(devices[0]["stable_key"]) if devices else None


def pick_unconfigured_target(bus: SocketCanBus, config: ConfigManager, listen_timeout: float) -> tuple[int, DeviceType | None] | None:
    reference_key = pick_reference_key(config)
    if reference_key is None:
        print("No configured devices yet to use as a board reference -- listening for all unconfigured devices.")
        reference_key = StableKey("product_id", 0, 0)  # will simply never match anything real

    print(f"Listening up to {listen_timeout:.0f}s for DEVICE_ID broadcasts...")
    result = scan_board(bus, reference_key, listen_timeout)

    if result.reference_product is not None:
        matches = {
            addr: identity
            for addr, identity in result.unconfigured.items()
            if (identity.product_id, identity.product_instance) == result.reference_product
        }
    else:
        matches = result.unconfigured

    if not matches:
        print("No unconfigured devices seen in this window.")
        return _prompt_raw_address()

    print("\nUnconfigured devices:")
    ordered = sorted(matches.items())
    for i, (addr, identity) in enumerate(ordered, start=1):
        device_type = identity.device_type
        type_label = device_type.name if device_type else f"UNKNOWN({identity.device_type_raw})"
        print(f"  {i}) addr=0x{addr:02X}  device_type={type_label}  device_instance={identity.device_instance}")
    print("  A) Enter a raw address directly")
    print("  Q) Cancel")
    choice = input("Select a target: ").strip().lower()
    if choice == "a":
        return _prompt_raw_address()
    if not choice or choice == "q":
        return None
    try:
        index = int(choice)
        if not (1 <= index <= len(ordered)):
            raise ValueError
    except ValueError:
        print("Invalid selection.")
        return None
    addr, identity = ordered[index - 1]
    return addr, identity.device_type


def _prompt_raw_address() -> tuple[int, DeviceType | None] | None:
    raw = input("Raw CAN address (e.g. 0x11), or blank to cancel: ").strip()
    if not raw:
        return None
    try:
        return int(raw, 0), None
    except ValueError:
        print("Invalid address.")
        return None


def pick_configured_target(
    bus: SocketCanBus, config: ConfigManager, listen_timeout: float
) -> tuple[int, DeviceType | None, dict | None] | None:
    devices = config.get_devices()
    if devices:
        print("\nConfigured devices:")
        for i, d in enumerate(devices, start=1):
            print(f"  {i}) {d.get('friendly_name', '(unnamed)')}  [{d.get('device_class', '?')}]  {d['stable_key']}")
    else:
        print("\nNo configured devices yet.")
    print("  A) Enter a raw address directly")
    print("  Q) Cancel")
    choice = input("Select a target: ").strip().lower()
    if choice == "a":
        result = _prompt_raw_address()
        return (result[0], result[1], None) if result else None
    if not choice or choice == "q":
        return None
    try:
        index = int(choice)
        if not (1 <= index <= len(devices)):
            raise ValueError
    except ValueError:
        print("Invalid selection.")
        return None

    device = devices[index - 1]
    target_key = StableKey.from_config_string(device["stable_key"])
    resolved = resolve_target_identity(bus, target_key, listen_timeout)
    if resolved is None:
        print(f"Timed out waiting for a DEVICE_ID broadcast matching {device['stable_key']}")
        return None
    addr, identity = resolved
    return addr, identity.device_type, device


