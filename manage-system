def flow_configure(bus: SocketCanBus, source: int, config: ConfigManager, listen_timeout: float, timeout_sec: float) -> None:
    print()
    print("=" * 44)
    print("  Configure a Port")
    print("=" * 44)
    print()
    print("  1) An unconfigured port")
    print("  2) An already-configured device")
    print("  Q) Back")
    choice = input("Which? ").strip().lower()
    if choice == "1":
        picked = pick_unconfigured_target(bus, config, listen_timeout)
        existing_config_entry = None
    elif choice == "2":
        picked3 = pick_configured_target(bus, config, listen_timeout)
        if picked3 is None:
            return
        picked = (picked3[0], picked3[1])
        existing_config_entry = picked3[2]
    else:
        return
    if picked is None:
        return

    _configure_target(bus, source, picked[0], picked[1], config, existing_config_entry, timeout_sec)


def _configure_target(
    bus: SocketCanBus,
    source: int,
    target: int,
    device_type: DeviceType | None,
    config: ConfigManager,
    existing_config_entry: dict | None,
    timeout_sec: float,
) -> None:
    any_changes_applied = False
    while True:
        type_label = device_type.name if device_type else "unknown (raw address, no DEVICE_ID seen)"
        print()
        print("=" * 44)
        print(f"  Target: 0x{target:02X}  (DEVICE_TYPE: {type_label})")
        print("=" * 44)

        current_name_pid = read_pid_value(bus, source, target, PID_IDS_CAN_FUNCTION_NAME, timeout_sec)
        current_instance_pid = read_pid_value(bus, source, target, PID_IDS_CAN_FUNCTION_INSTANCE, timeout_sec)
        current_name_label = function_name_label(current_name_pid) if current_name_pid is not None else "?"
        print(f"  Current identity: {current_name_label} (FUNCTION_NAME={current_name_pid}, instance={current_instance_pid})")

        settings = applicable_settings(device_type)
        current_setting_values: dict[int, int | None] = {}
        for setting in settings:
            value = read_pid_value(bus, source, target, setting.pid, timeout_sec)
            current_setting_values[setting.pid] = value
            if value is None:
                print(f"  {setting.name}: not supported on this device")
            else:
                print(f"  {setting.name} = {value}  ({setting.description})")

        print()
        print("  1) Change identity (name/instance)")
        for i, setting in enumerate(settings, start=2):
            if current_setting_values.get(setting.pid) is not None:
                print(f"  {i}) Change {setting.name}")
        print("  Q) Done / back")
        choice = input("What do you want to change? ").strip().lower()

        pending: list[tuple[int, int, str]] = []  # (pid, value, label)

        if choice == "1":
            query = input("Search FUNCTION_NAME (part of a name, or blank to browse all 446): ").strip()
            matches = search_function_names(query)
            if not matches:
                print("No matches.")
                continue
            new_name_pid = browse_and_pick(matches)
            if new_name_pid is None:
                continue
            instance_str = input("Function instance [0]: ").strip()
            new_instance_pid = int(instance_str) if instance_str else 0
            pending.append((PID_IDS_CAN_FUNCTION_NAME, new_name_pid, "FUNCTION_NAME"))
            pending.append((PID_IDS_CAN_FUNCTION_INSTANCE, new_instance_pid, "FUNCTION_INSTANCE"))
        elif choice.isdigit() and 2 <= int(choice) < 2 + len(settings):
            setting = settings[int(choice) - 2]
            new_value_str = input(f"New value for {setting.name} [current: {current_setting_values[setting.pid]}]: ").strip()
            if not new_value_str:
                continue
            try:
                new_value = int(new_value_str, 0)
            except ValueError:
                print("Invalid value.")
                continue
            pending.append((setting.pid, new_value, setting.name))
        elif choice == "q" or not choice:
            break
        else:
            print("Invalid selection.")
            continue

        print("\nPending change(s):")
        for pid, value, label in pending:
            print(f"  Write PID {pid} ({label}) = {value}")
        if not prompt_yes_no("Apply these change(s)?", default_yes=True):
            continue

        any_changes_applied = True
        all_passed = True
        for pid, value, label in pending:
            print(f"\n  Writing {label} (PID {pid})...")
            if not write_pid_verified(bus, source, target, pid, value, timeout_sec):
                all_passed = False
        if not all_passed:
            print("\n  *** One or more writes did NOT verify -- the device may be unchanged. ***")
            input("  Press Enter to acknowledge before continuing: ")

    if not any_changes_applied:
        print("\nNo changes made.")
        return

    _post_configure(bus, source, target, device_type, config, existing_config_entry, timeout_sec)


def _post_configure(
    bus: SocketCanBus,
    source: int,
    target: int,
    device_type: DeviceType | None,
    config: ConfigManager,
    existing_config_entry: dict | None,
    timeout_sec: float,
) -> None:
    tested_ok: bool | None = None
    if prompt_yes_no("\nTest this device now?", default_yes=True):
        hold = DEFAULT_TEST_HOLD_SECONDS
        try:
            send_test_blip(bus, source, target, device_type, hold, timeout_sec)
        except SessionOpenError as e:
            print(f"Test aborted: {e}")
        else:
            tested_ok = prompt_yes_no("Did it behave as expected?", default_yes=True)

        if tested_ok is False:
            print("\n  1) Try different settings")
            print("  2) Revert identity to unconfigured (FUNCTION_NAME=0/FUNCTION_INSTANCE=0)")
            print("  3) Leave as-is")
            choice = input("What now? ").strip()
            if choice == "1":
                _configure_target(bus, source, target, device_type, config, existing_config_entry, timeout_sec)
                return
            if choice == "2":
                if not prompt_yes_no("  Revert identity to unconfigured? This writes immediately.", default_yes=False):
                    print("  Cancelled -- nothing written.")
                    return
                print("\n  Reverting identity...")
                ok1 = write_pid_verified(bus, source, target, PID_IDS_CAN_FUNCTION_NAME, 0, timeout_sec)
                ok2 = write_pid_verified(bus, source, target, PID_IDS_CAN_FUNCTION_INSTANCE, 0, timeout_sec)
                if ok1 and ok2:
                    print("  Reverted to unconfigured.")
                    if existing_config_entry is not None:
                        print(f"\n  Note: {existing_config_entry.get('friendly_name')!r} is still in config.json,")
                        print("  but its stable_key will no longer resolve reliably now that FUNCTION_NAME=0.")
                        if prompt_yes_no("  Remove it from config.json now?", default_yes=True):
                            config.remove_device(StableKey.from_config_string(existing_config_entry["stable_key"]))
                            print("  Removed from config.json.")
                else:
                    print("  Revert did not fully verify -- check with pid_probe.py before trusting this port's state.")
                return

    if existing_config_entry is not None:
        print("\nThis device was already in config.json -- a settings-only change doesn't need any config.json update.")
        return

    if prompt_yes_no("\nAdd this device to config.json now?", default_yes=True):
        name_pid = read_pid_value(bus, source, target, PID_IDS_CAN_FUNCTION_NAME, timeout_sec)
        instance_pid = read_pid_value(bus, source, target, PID_IDS_CAN_FUNCTION_INSTANCE, timeout_sec) or 0
        if name_pid is None or name_pid == 0:
            print("This device doesn't have a real FUNCTION_NAME yet -- rename it first.")
            return
        stable_key = StableKey("function_name", name_pid, instance_pid)
        suggested_name = function_name_label(name_pid)
        device_class = infer_device_class(stable_key, device_type.name) if device_type else None
        if device_class is None:
            print(f"No supported device_class for DEVICE_TYPE={device_type} -- add manually with manage-devices if needed.")
            return
        friendly_name = input(f"Friendly name [{suggested_name}]: ").strip() or suggested_name
        expose = prompt_yes_no("Expose on D-Bus now?", default_yes=True)
        config.add_device(stable_key, friendly_name, device_class, expose=expose, commands_enabled=False)
        print(f"Added {friendly_name!r} to config.json (device_class={device_class}). Commands disabled by default -- use manage-devices to enable.")


# ---------------------------------------------------------------------------
# Flow 2: Unconfigure a port
# ---------------------------------------------------------------------------


def flow_unconfigure(bus: SocketCanBus, source: int, config: ConfigManager, listen_timeout: float, timeout_sec: float) -> None:
    print()
    print("=" * 44)
    print("  Unconfigure a Port")
    print("=" * 44)
    print()
    print("  This resets a device's identity back to unconfigured")
    print("  (FUNCTION_NAME=0, FUNCTION_INSTANCE=0). This can affect a")
    print("  device you actually rely on -- not just a spare port.")
    print()

    # pick_configured_target already offers "enter a raw address" as an
    # in-menu option -- None here means the user actually cancelled, not
    # "no address was given," so respect that rather than re-prompting.
    picked = pick_configured_target(bus, config, listen_timeout)
    if picked is None:
        return
    target, device_type, existing_config_entry = picked

    current_name_pid = read_pid_value(bus, source, target, PID_IDS_CAN_FUNCTION_NAME, timeout_sec)
    current_label = function_name_label(current_name_pid) if current_name_pid is not None else "?"
    print(f"\nTarget 0x{target:02X} currently: {current_label} (FUNCTION_NAME={current_name_pid})")

    if not prompt_yes_no(f'Really unconfigure "{current_label}"?', default_yes=False):
        print("Cancelled.")
        return
    if not prompt_yes_no("This cannot be undone without re-naming it manually. Confirm again?", default_yes=False):
        print("Cancelled.")
        return

    ok1 = write_pid_verified(bus, source, target, PID_IDS_CAN_FUNCTION_NAME, 0, timeout_sec)
    ok2 = write_pid_verified(bus, source, target, PID_IDS_CAN_FUNCTION_INSTANCE, 0, timeout_sec)
    if not (ok1 and ok2):
        print("Unconfigure did not fully verify -- check with pid_probe.py before trusting this port's state.")
        return
    print("Unconfigured.")

    if existing_config_entry is not None:
        print(f"\nNote: {existing_config_entry.get('friendly_name')!r} is still in config.json, but its stable_key")
        print("will no longer resolve reliably now that FUNCTION_NAME=0 (falls back to the ambiguous")
        print("product_id/instance key shared by every unconfigured port).")
        if prompt_yes_no("Remove it from config.json now?", default_yes=True):
            config.remove_device(StableKey.from_config_string(existing_config_entry["stable_key"]))
            print("Removed from config.json.")


# ---------------------------------------------------------------------------
# Flow 3: Back up current settings of all ports
# ---------------------------------------------------------------------------


def flow_backup(bus: SocketCanBus, source: int, listen_timeout: float, timeout_sec: float) -> None:
    print()
    print("=" * 44)
    print("  Back Up Current Settings of All Ports")
    print("=" * 44)
    print()
    print("Read-only -- nothing is written.")
    print(f"Listening up to {listen_timeout:.0f}s for DEVICE_ID broadcasts...")

    result = scan_board(bus, StableKey("product_id", 0, 0), listen_timeout)
    all_devices = result.all_devices

    snapshot = []
    for addr, identity in sorted(all_devices.items()):
        entry = {
            "address": f"0x{addr:02X}",
            "product_id": identity.product_id,
            "product_instance": identity.product_instance,
            "device_type_raw": identity.device_type_raw,
            "device_type": identity.device_type.name if identity.device_type else None,
            "function_name": identity.function_name,
            "function_name_label": function_name_label(identity.function_name),
            "function_instance": identity.function_instance,
            "device_instance": identity.device_instance,
            "capabilities_raw": identity.capabilities_raw,
            "settings": {},
        }
        for setting in applicable_settings(identity.device_type):
            value = read_pid_value(bus, source, addr, setting.pid, timeout_sec)
            entry["settings"][setting.name] = value
        snapshot.append(entry)
        print(f"  0x{addr:02X}  {entry['function_name_label']}  device_type={entry['device_type']}")

    SAMPLES_DIR.mkdir(exist_ok=True)
    out_path = SAMPLES_DIR / f"port_backup_{time.strftime('%Y%m%d_%H%M%S')}.json"
    out_path.write_text(json.dumps(snapshot, indent=2))
    print(f"\nWrote {len(snapshot)} device(s) to {out_path}")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


def main() -> int:
    if not show_startup_warning():
        print("Not confirmed -- exiting.")
        return 1

    config_path = Path(sys.argv[1]) if len(sys.argv) > 1 else DEFAULT_CONFIG_PATH
    if not config_path.exists():
        print(f"Error: config file not found: {config_path}")
        return 1
    config = ConfigManager(config_path)

    interface = os.environ.get("ONECONTROL_CAN_INTERFACE", DEFAULT_INTERFACE)
    with SocketCanBus(interface) as bus:
        bridge_address = claim_bridge_address(bus)
        print(f"Claimed bridge address 0x{bridge_address:02X}")

        while True:
            print()
            print("=" * 44)
            print("  OneControl System Configuration")
            print("=" * 44)
            print()
            print("  1) Configure a port")
            print("  2) Unconfigure a port")
            print("  3) Back up current settings of all ports")
            print("  Q) Quit")
            choice = input("Choose an action: ").strip().lower()

            if choice == "1":
                flow_configure(bus, bridge_address, config, DEFAULT_LISTEN_TIMEOUT_SEC, DEFAULT_RESPONSE_TIMEOUT_SEC)
            elif choice == "2":
                flow_unconfigure(bus, bridge_address, config, DEFAULT_LISTEN_TIMEOUT_SEC, DEFAULT_RESPONSE_TIMEOUT_SEC)
            elif choice == "3":
                flow_backup(bus, bridge_address, DEFAULT_LISTEN_TIMEOUT_SEC, DEFAULT_RESPONSE_TIMEOUT_SEC)
            elif choice == "q" or not choice:
                break
            else:
                print("Invalid selection.")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
